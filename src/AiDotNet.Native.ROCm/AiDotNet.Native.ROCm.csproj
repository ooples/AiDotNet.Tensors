<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <PackageId>AiDotNet.Native.ROCm</PackageId>
    <Version>6.3.0</Version>
    <Authors>AiDotNet Contributors</Authors>
    <Company>AiDotNet</Company>
    <Description>Native AMD ROCm binaries (rocBLAS + MIOpen) for GPU-accelerated deep learning on AMD GPUs. Provides assembly-tuned GEMM (rocBLAS) achieving 60-80% peak TFLOPS, and optimized convolution/normalization/pooling/attention primitives (MIOpen). Install this package alongside AiDotNet.Tensors for automatic AMD GPU acceleration via HIP.</Description>
    <PackageTags>rocm;rocblas;miopen;hip;amd;gpu;blas;deep-learning;native</PackageTags>
    <!-- The binaries are AMD's (MIT rocBLAS/hipBLAS and the proprietary Windows HIP runtime), not ours, so the
         package declares a licence file that names each one rather than an SPDX expression. -->
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageProjectUrl>https://github.com/ooples/AiDotNet.Tensors</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ooples/AiDotNet.Tensors</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- This is a native-only package, no managed code -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>

    <!-- Include native libraries in package -->
    <ContentTargetFolders>content</ContentTargetFolders>
  </PropertyGroup>

  <!-- Windows x64 native libraries (ROCm for Windows) -->
  <ItemGroup>
    <None Include="runtimes\win-x64\native\rocblas.dll" Pack="true" PackagePath="runtimes\win-x64\native" Condition="Exists('runtimes\win-x64\native\rocblas.dll')" />
    <None Include="runtimes\win-x64\native\hipblas.dll" Pack="true" PackagePath="runtimes\win-x64\native" Condition="Exists('runtimes\win-x64\native\hipblas.dll')" />
    <None Include="runtimes\win-x64\native\amdhip64_6.dll" Pack="true" PackagePath="runtimes\win-x64\native" Condition="Exists('runtimes\win-x64\native\amdhip64_6.dll')" />
    <None Include="runtimes\win-x64\native\MIOpen.dll" Pack="true" PackagePath="runtimes\win-x64\native" Condition="Exists('runtimes\win-x64\native\MIOpen.dll')" />
    <None Include="runtimes\win-x64\native\hiprtc.dll" Pack="true" PackagePath="runtimes\win-x64\native" Condition="Exists('runtimes\win-x64\native\hiprtc.dll')" />
  </ItemGroup>

  <!-- Ensure the native libraries are copied to output -->
  <ItemGroup>
    <None Update="runtimes\**\*" CopyToOutputDirectory="PreserveNewest" Link="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Upstream licence text and the inventory (version, licence, SHA-256) of every redistributed
       native file. No Exists() condition: a missing file must fail the pack, not ship a package
       without its licence. -->
  <ItemGroup>
    <None Include="LICENSE.txt" Pack="true" PackagePath="\" />
    <None Include="LICENSE.rocBLAS.txt" Pack="true" PackagePath="\" />
    <None Include="LICENSE.hipBLAS.txt" Pack="true" PackagePath="\" />
    <None Include="NATIVE-MANIFEST.json" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Build targets to copy native libraries -->
  <ItemGroup>
    <None Include="build\AiDotNet.Native.ROCm.targets" Pack="true" PackagePath="build" />
  </ItemGroup>

</Project>
