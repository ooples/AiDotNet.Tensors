<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      net10.0 — latest; full AVX2/AVX-512 + AVX-VNNI int8/int4 kernels (serves net10/net11)
      net8.0  — LTS; AVX2/AVX-512 intrinsics. (AVX-VNNI is [RequiresPreviewFeatures] on
                net8 — compiled out via #if NET9_0_OR_GREATER — so it routes to AVX2/scalar.)
                Without this target, net8/net9 consumers had no compatible modern asset and
                NuGet's AssetTargetFallback silently selected the net471 .NET Framework build
                (NU1701). See issue #679 for extending to net462 + netstandard2.0.
      net471  — .NET Framework 4.7.1–4.8.1 (scalar fallback, no System.Runtime.Intrinsics)
    -->
    <TargetFrameworks>net10.0;net8.0;net471;net462;netstandard2.0</TargetFrameworks>
    <!-- The target's framework family (.NETCoreApp / .NETFramework / .NETStandard), for conditions in this file:
         TargetFrameworkIdentifier itself is only inferred after the project body is evaluated. -->
    <AiDnTargetFrameworkIdentifier>$([MSBuild]::GetTargetFrameworkIdentifier('$(TargetFramework)'))</AiDnTargetFrameworkIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Version>1.0.0-preview</Version>
    <Title>AiDotNet.Tensors</Title>
    <Description>High-performance tensor operations with SIMD acceleration for .NET. Provides Vector, Matrix, and Tensor types with hardware-accelerated operations (Sin, Cos, Exp, Log, etc.). On net8.0+ uses hand-written AVX2/AVX-512 SIMD kernels via System.Runtime.Intrinsics for maximum throughput; on net471 falls back to scalar paths (System.Runtime.Intrinsics is unavailable pre-net6). Performance numbers in benchmarks assume net8.0+. Supports any numeric type via generic INumericOperations interface. Optional GPU acceleration available via separate packages. Optional anonymous telemetry (opt-in via AIDOTNET_TELEMETRY=true; default off in v0.205.0+).</Description>
    <Company>Ooples Finance</Company>
    <Authors>ooples</Authors>
    <Copyright>Ooples Finance LLC 2025</Copyright>
    <PackageProjectUrl>https://github.com/ooples/AiDotNet.Tensors</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/ooples/AiDotNet.Tensors</RepositoryUrl>
    <PackageTags>tensors; simd; vectorization; linear-algebra; matrix; vector; performance; net471; net10; avx2; avx512; gpu</PackageTags>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <LangVersion>latest</LangVersion>
    <EvolutionProjectPath Condition="'$(EvolutionProjectPath)' == ''">$(MSBuildProjectDirectory)\..\..\..\AiDotNet.Evolution\src\AiDotNet.Evolution\AiDotNet.Evolution.csproj</EvolutionProjectPath>
    <PackageIcon>Favicon.jpg</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- Backend parity gate (TENS0001-TENS0005): every GPU capability must exist natively on all six
       DirectGpu backends. Build-only; the analyzer is not shipped to package consumers. Known gaps are
       listed with tracking issues in BackendParityBaseline.txt, which may only shrink. -->
  <ItemGroup>
    <ProjectReference Include="..\AiDotNet.Tensors.Analyzers\AiDotNet.Tensors.Analyzers.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <AdditionalFiles Include="BackendParityBaseline.txt" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalEvolution)' == 'true'">
    <ProjectReference Include="$(EvolutionProjectPath)" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalEvolution)' != 'true'">
    <!-- Stable, not 0.1.0-preview.1: NuGet fails `pack` with NU5104 ("a stable
         release of a package should not have a prerelease dependency") when a
         stable Tensors release depends on a prerelease, which blocked the
         v0.131.0 and v0.132.0 release pipelines at the Pack NuGet job. -->
    <PackageReference Include="AiDotNet.Evolution" Version="0.3.0" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Define WINDOWS for correct DLL names on Windows -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) or '$(AiDnTargetFrameworkIdentifier)' == '.NETFramework'">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only operator-isolated, manifested direct-PTX release cubins are
         executable package resources. Loose legacy files under smXX remain
         excluded until they pass the same source/hash/resource gates. -->
    <EmbeddedResource Include="Engines\DirectGpu\CUDA\Ptx\Artifacts\*\*\*.cubin" />
    <EmbeddedResource Include="Engines\DirectGpu\CUDA\Ptx\Artifacts\*\*\*-cubins.tsv" />
    <EmbeddedResource Include="Engines\DirectGpu\CUDA\Ptx\Artifacts\*\*\*.linker.txt" />
    <InternalsVisibleTo Include="AiDotNet" />
    <InternalsVisibleTo Include="AiDotNetTests" />
    <!-- AiDotNet's benchmark, serving dev-host and serving test assemblies read tensor storage through
         AsSpan, which is internal since the storage rework; the main AiDotNet grant does not cover them. -->
    <InternalsVisibleTo Include="AiDotNet.Benchmarks" />
    <InternalsVisibleTo Include="AiDotNet.Serving.DevHost" />
    <InternalsVisibleTo Include="AiDotNet.Serving.Tests" />
    <InternalsVisibleTo Include="AiDotNet.Tensors.Tests" />
    <InternalsVisibleTo Include="AiDotNet.Tensors.Autotune.Tests" />
    <InternalsVisibleTo Include="AiDotNet.Tensors.Benchmarks" />
    <InternalsVisibleTo Include="OptBench" />
    <!-- tools/ConvParallelProbe (the gemm-bench CI job builds it): it reads tensors' backing arrays, which are
         internal since undisposed result buffers are recycled (#1118). -->
    <InternalsVisibleTo Include="ConvParallelProbe" />
    <InternalsVisibleTo Include="AiDotNet.Tensors.Onnx" />
    <InternalsVisibleTo Include="AiDotNet.Tensors.Onnx.Tests" />
    <InternalsVisibleTo Include="HarmonicEngine" />
    <InternalsVisibleTo Include="HarmonicEngine.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Images\Favicon.jpg">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\..\LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\..\THIRD-PARTY-NOTICES.txt">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>

    <!--
      The two enterprise .targets files are STATIC (they always exist in the
      repo) and are packed here as static <None> items so the NuGet-convention
      file 'build/AiDotNet.Tensors.targets' is ALWAYS present in the package's
      build/ folder. This must be static, not added by the dynamic
      PackLicenseValidatorAssets target: under GeneratePackageOnBuild the pack
      file-collection / NU5129 validation can run before a
      BeforeTargets="_GetPackageFiles" hook populates its ItemGroup, which left
      the conventional shim out of the package and broke the release pipeline
      with `error NU5129: ... 'build/AiDotNet.Tensors.targets' was not [found]`.
      Static items are evaluated at project load, so they're immune to that
      ordering. Only the validator DLL closure (which doesn't exist until built)
      stays dynamic in PackLicenseValidatorAssets.
    -->
    <None Include="..\..\build\AiDotNet.Tensors.targets">
      <Pack>true</Pack>
      <PackagePath>build\</PackagePath>
    </None>
    <None Include="..\..\build\AiDotNet.Tensors.Enterprise.targets">
      <Pack>true</Pack>
      <PackagePath>build\</PackagePath>
    </None>
    <None Include="..\..\build\AiDotNet.Tensors.NativeAssets.targets">
      <Pack>true</Pack>
      <PackagePath>build\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!--
      No native CPU math libraries ship with this package. GEMM runs the managed
      BlasManaged kernels; element-wise transcendentals run SimdKernels; Conv2D runs
      FusedConv + SimdGemm / Winograd / SIMD-direct. MKL.NET was removed under #131, and
      OpenBLAS (AiDotNet.Native.OpenBLAS), Microsoft.ML.Mkl.Redist and intelmkl.redist
      under #368, once the managed GEMM reached rough parity with OpenBLAS.
    -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <!-- System.Numerics.Tensors deliberately NOT referenced. Our in-house
       SimdKernels (AVX2/AVX-512 Cody-Waite Exp/Log + Padé Tanh/Sigmoid +
       4× unrolled Vector256 multiply-add primitives) consistently beat
       TensorPrimitives at every shape we benchmark, and pulling in an
       external NuGet just to wrap a few hot paths increases supply-chain
       attack surface for zero correctness or performance benefit.
       Empirically observed regressions on .NET 9.0.0 TensorPrimitives:
         Tanh(float)   1M:  369 µs in-house vs 7,325 µs TP (20× slower)
         Sigmoid(double) 1M:  530 µs in-house vs 6,121 µs TP (12× slower)
         Log(double)   1M: 2,512 µs in-house vs 9,342 µs TP (4× slower)
       Don't reintroduce the package. -->

  <!-- System.Text.Json is needed for net471 as it's not built-in like net8.0.
       Pinned to 10.0.12 to match what AiDotNet.Evolution asks for on net471: it
       declares System.Text.Json >= 10.0.12 there, so referencing anything older
       directly wins the resolution and NuGet reports it as a downgrade (NU1605),
       which TreatWarningsAsErrors turns into a build failure. Keep this at or
       above whatever the referenced AiDotNet.Evolution requires. -->
  <ItemGroup Condition="'$(AiDnTargetFrameworkIdentifier)' == '.NETFramework'">
    <PackageReference Include="System.Text.Json" Version="10.0.12" />
    <!-- ZipArchive (System.IO.Compression) ships in mscorlib on .NET 5+ but
         needs an explicit reference on net471 — used by PtReader to parse
         the modern zip-format PyTorch checkpoint. -->
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <!-- System.Threading.Channels is in BCL on .NET 5+; net471 needs the
         compat package. Used by the multi-worker DataLoader (#216). -->
    <PackageReference Include="System.Threading.Channels" Version="8.0.0" />
  </ItemGroup>

  <!-- .NET Framework 4.6.2 (#679): RuntimeInformation / Architecture are built into 4.7.1+ only. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net462'">
    <PackageReference Include="System.Runtime.InteropServices.RuntimeInformation" Version="4.3.0" />
  </ItemGroup>

  <!-- .NET Standard 2.0 (#679: .NET 5/6/7, Unity/Mono and other netstandard consumers): the same BCL polyfills as
       .NET Framework, plus Reflection.Emit for the compiled-backward IL path. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="10.0.12" />
    <PackageReference Include="System.Threading.Channels" Version="8.0.0" />
    <PackageReference Include="System.Reflection.Emit" Version="4.7.0" />
    <PackageReference Include="System.Reflection.Emit.ILGeneration" Version="4.7.0" />
    <PackageReference Include="System.Reflection.Emit.Lightweight" Version="4.7.0" />
  </ItemGroup>

  <!-- Cross-TFM packages: needed on both net10.0 and net471. Don't add to
       the net471-only block above. -->
  <ItemGroup>
    <!-- LZ4 compression for the streaming pool's backing store (#1222).
         ~30-40% disk-footprint reduction on near-Gaussian fp32 weights at
         ~3 GB/s decompress. K4os.Compression.LZ4 is the de-facto LZ4
         binding for .NET; cross-TFM (net46+), 100% managed, zero native
         deps. Supply-chain note: this is the project's first new external
         runtime dep since the MKL.NET removal — LZ4 was deemed worth the
         dep because (a) it's tiny (~80 KB), (b) it has no transitive
         deps, (c) reimplementing LZ4 is a non-trivial CPU-perf undertaking
         that would just reinvent the same algorithm. The dep is gated
         behind GpuOffloadOptions.EnableCompression (default false), so
         users who don't opt into compression don't load LZ4 at runtime
         either. Alternatives considered + rejected: System.IO.Compression
         GZip (built-in but ~3× slower decompress), no compression
         (loses 30-40% disk-footprint reduction). -->
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
  </ItemGroup>

  <!--
    Vulkan's generated-kernel path lowers GLSL to SPIR-V at runtime through
    shaderc_shared. Shipping the native runtime transitively keeps this a
    user capability instead of silently requiring a developer-installed
    Vulkan SDK. The package carries native assets for Windows, Linux, and
    macOS across their supported x64/Arm RIDs; our existing P/Invoke surface
    remains the only managed binding layer.
  -->
  <ItemGroup>
    <PackageReference Include="Silk.NET.Shaderc.Native" Version="2.23.0" />
  </ItemGroup>

  <!--
    BouncyCastle.Cryptography (Org.BouncyCastle) — Ed25519 (EdDSA, RFC 8032) verification for the offline
    `aidn2.` license-token path (AsymmetricEntitlementVerifier / Ed25519LicenseRevocation). This is the
    Tensors runtime's FIRST BouncyCastle dependency: the rest of the runtime deliberately uses only
    System.Security.Cryptography, but .NET ships no Ed25519 type on ANY target (net471/net8/net10), so the
    signed-token verifier needs a portable Ed25519 implementation across all three TFMs. Version pinned to
    2.6.2 to match the main AiDotNet SDK, so a token minted by the SDK verifies identically here. Cross-TFM
    (net461+), 100% managed, no native/transitive deps. -->
  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
  </ItemGroup>


  <!--
    GPU-side optional packages — separate supply-chain surface (users opt in
    per-hardware): AiDotNet.Native.CLBlast (OpenCL), AiDotNet.Native.CUDA
    (NVIDIA), AiDotNet.Native.ROCm (AMD), AiDotNet.Native.MoltenVK (macOS/iOS).
    The core package works without any of them using managed fallbacks + the
    in-house CPU kernels (SimdGemm / SimdKernels / FusedConv).
  -->

  <!-- Exclude files that require .NET Core intrinsics from .NET Framework and .NET Standard builds -->
  <ItemGroup Condition="'$(AiDnTargetFrameworkIdentifier)' != '.NETCoreApp'">
    <Compile Remove="Helpers\SimdVector.cs" />
    <Compile Remove="Helpers\SimdConvHelper.cs" />
    <Compile Remove="Helpers\OneDnnProvider.cs" />
    <Compile Remove="Helpers\NativeMemoryManager.cs" />
    <Compile Remove="Helpers\FusedConvHelper.cs" />
    <!-- SupabaseTelemetryClient needs System.Net.Http which was transitively brought in
         by MKL.NET.win-x64 pre-removal. The telemetry path is only useful on net10.0
         runtimes (the GPU backends we wire it into), so excluding it on net471 is safe. -->
    <Compile Remove="Engines\DirectGpu\Telemetry\SupabaseTelemetryClient.cs" />
    <!-- SupabaseGpuTuningExchange (Phase 2 community autotune) is net10-only for the
         same reason: it depends on System.Net.Http + System.Text.Json. net471
         participates in local autotune fully via the NullGpuTuningExchange. -->
    <Compile Remove="Engines\DirectGpu\Telemetry\SupabaseGpuTuningExchange.cs" />
  </ItemGroup>

  <!--
    Telemetry credentials: injected at build time via CI/CD.
    Pass -p:TelemetryUrl=... -p:TelemetryKey=... during dotnet build/pack.
    Values are embedded as AssemblyMetadata so the published NuGet DLL has them,
    but the source code never contains credentials.
  -->
  <PropertyGroup>
    <!-- Embedded defaults point at the Ooples aidotnet-gpu-telemetry project.
         The publishable key is public-by-design (RLS restricts anon to
         insert/select on the telemetry tables); a runtime AIDOTNET_TELEMETRY_URL /
         AIDOTNET_TELEMETRY_KEY env var overrides it, and telemetry stays OFF
         unless AIDOTNET_TELEMETRY=true regardless. CI may still override with
         -p:TelemetryUrl=... -p:TelemetryKey=... -->
    <TelemetryUrl Condition="'$(TelemetryUrl)' == ''">https://yfkqwpgjahoamlgckjib.supabase.co</TelemetryUrl>
    <TelemetryKey Condition="'$(TelemetryKey)' == ''">sb_publishable_ZMB8J8H82gdHAatyNOVDyA__hUWhREZ</TelemetryKey>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>TelemetryUrl</_Parameter1>
      <_Parameter2>$(TelemetryUrl)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>TelemetryKey</_Parameter1>
      <_Parameter2>$(TelemetryKey)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!--
    audit-2026-05 Phase 4: gate AIDOTNET_DISABLE_TELEMETRY / AIDOTNET_DISABLE_LICENSE_GUARD
    compile flags behind RSA-2048 PKCS#1 v1.5 SHA-256 enterprise-license
    signature verification + secret license-key binding. See build/AiDotNet.Tensors.Enterprise.targets
    for the validation flow and build/LicenseValidator/README.md for the
    operator-side keypair-generation procedure.
  -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\build\AiDotNet.Tensors.Enterprise.targets" />

  <!-- shaderc_shared for .NET Framework builds; see the file for why Silk's own copy misses them. -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\build\AiDotNet.Tensors.NativeAssets.targets" />

  <!-- #375 Phase 4: shipped per-fingerprint pre-warm autotune caches. Empty until CI
       produces them, so the glob matching nothing is a build no-op. The README is not
       embedded. -->
  <ItemGroup>
    <EmbeddedResource Include="Engines\BlasManaged\Autotune\prewarm\*.prewarm.json" />
    <!-- Shipped tuned-kernel registry profiles (per device), see TunedKernelProfiles. -->
    <EmbeddedResource Include="Helpers\Autotune\TunedKernels\Profiles\*.tuned-profile.json" />
    <!-- #1204: the Joe-Kuo Sobol direction numbers, packed by scripts/pack_joe_kuo.py. -->
    <EmbeddedResource Include="Engines\DevicePrimitives\Cpu\Data\joe-kuo-6.bin" />
  </ItemGroup>

  <!-- Optional signed revocation deny-list (CRL) for signed entitlements, verified by
       TensorsLicenseRevocation against the embedded entitlement key. Additive/fail-open: absent =>
       nothing revoked. Injected (and refreshed) at release with the current signed CRL. -->
  <ItemGroup>
    <EmbeddedResource Include="Licensing\LicenseRevocation.json" Condition="Exists('Licensing\LicenseRevocation.json')">
      <LogicalName>AiDotNet.Tensors.LicenseRevocation</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Embedded PUBLIC Ed25519 signing key(s) (JWK OKP set) used by AsymmetricEntitlementVerifier to verify
       `aidn2.` tokens offline. Contains the real prod-2026a public key; the private half never ships. -->
  <ItemGroup>
    <EmbeddedResource Include="Licensing\LicensePublicKey.json">
      <LogicalName>AiDotNet.Tensors.LicensePublicKey</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Optional signed Ed25519 revocation deny-list (CRL) for `aidn2.` tokens, verified by
       Ed25519LicenseRevocation against the embedded Ed25519 public key. Additive/fail-open: absent =>
       nothing revoked. Injected (and refreshed) at release with the current signed CRL. Kept separate from
       the RSA LicenseRevocation.json above (different signing key / trust root). -->
  <ItemGroup>
    <EmbeddedResource Include="Licensing\LicenseRevocationEd25519.json" Condition="Exists('Licensing\LicenseRevocationEd25519.json')">
      <LogicalName>AiDotNet.Tensors.LicenseRevocationEd25519</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
