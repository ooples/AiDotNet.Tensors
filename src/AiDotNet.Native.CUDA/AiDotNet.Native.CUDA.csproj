<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <PackageId>AiDotNet.Native.CUDA</PackageId>
    <Version>12.5.0</Version>
    <Authors>AiDotNet Contributors</Authors>
    <Company>AiDotNet</Company>
    <Description>Native CUDA binaries for NVIDIA GPU-accelerated operations. Provides cuBLAS + the nvRTC runtime kernel compiler required by AiDotNet.Tensors for NVIDIA GPU acceleration (no CUDA Toolkit install needed).</Description>
    <PackageTags>cuda;nvidia;gpu;blas;native;cublas;nvrtc</PackageTags>
    <!-- The binaries are NVIDIA's, not ours, so the package declares a licence file (NVIDIA's EULA behind a header
         naming the files it covers) rather than an SPDX expression. WriteCudaPackageLicense below generates it. -->
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageProjectUrl>https://github.com/ooples/AiDotNet.Tensors</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ooples/AiDotNet.Tensors</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- This is a native-only package, no managed code -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>

    <!-- Include native libraries in package -->
    <ContentTargetFolders>content</ContentTargetFolders>
  </PropertyGroup>

  <!-- Windows x64 native libraries: cudart, cuBLAS, cuBLASLt, AND nvRTC (+ builtins),
       staged by tools/stage-cuda-redist.ps1 (gitignored, ~770MB).

       IMPORTANT: this project does NOT pack the DLLs directly — the full runtime is far
       over nuget.org's 250 MB per-package limit (cuBLAS / cuBLASLt EACH exceed it). The
       shipped package is produced by tools/pack-cuda-split.ps1, which splits the runtime
       into <250 MB AiDotNet.Native.CUDA.Fragments.* packages plus a meta package whose
       build/AiDotNet.Native.CUDA.targets reassembles the DLLs at the consumer's build.
       The items below only copy the staged DLLs to THIS project's output for local dev. -->

  <!-- Ensure the native libraries are copied to output for local development/debugging. -->
  <ItemGroup>
    <None Include="runtimes\**\*.dll" CopyToOutputDirectory="PreserveNewest" Link="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- NVIDIA's licence for the redistributed runtime. tools/pack-cuda-split.ps1 packs it, together with the
       NATIVE-MANIFEST.json that tools/stage-cuda-redist.ps1 generates, into the meta and fragment packages. -->
  <ItemGroup>
    <None Include="LICENSE.CUDA.txt" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- The package licence file is PACKAGE-LICENSE-HEADER.txt followed by LICENSE.CUDA.txt. It is generated rather than
       committed so NVIDIA's text exists once, byte-identical to the archive copy tools/stage-cuda-redist.ps1 checks.
       tools/pack-cuda-split.ps1 builds the same file for the published meta and fragment packages. -->
  <Target Name="WriteCudaPackageLicense" BeforeTargets="_GetPackageFiles">
    <PropertyGroup>
      <_CudaPackageLicense>$(MSBuildProjectDirectory)\$(IntermediateOutputPath)LICENSE.txt</_CudaPackageLicense>
      <_CudaPackageLicenseText>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\PACKAGE-LICENSE-HEADER.txt'))$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\LICENSE.CUDA.txt'))</_CudaPackageLicenseText>
    </PropertyGroup>
    <WriteLinesToFile File="$(_CudaPackageLicense)" Lines="$([MSBuild]::Escape($(_CudaPackageLicenseText)))" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <None Include="$(_CudaPackageLicense)" Pack="true" PackagePath="LICENSE.txt" />
    </ItemGroup>
  </Target>

  <!-- Build targets to copy native library -->
  <ItemGroup>
    <None Include="build\AiDotNet.Native.CUDA.targets" Pack="true" PackagePath="build" />
  </ItemGroup>

</Project>
