<Project Sdk="Microsoft.NET.Sdk">
  <!--
    #679: runs the netstandard2.0 asset of AiDotNet.Tensors. A net5.0 app resolves the netstandard2.0 build of the
    library (the package has no net5.0-7.0 asset), so this exercises exactly what a .NET 5/6/7, Unity or Mono consumer
    loads. Exit code 0 = every check passed.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net5.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <!-- net5.0 is out of support; this project exists only to load the netstandard2.0 asset. -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    <NoWarn>$(NoWarn);NU1902;NU1903</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\AiDotNet.Tensors\AiDotNet.Tensors.csproj" SetTargetFramework="TargetFramework=netstandard2.0" />
  </ItemGroup>
</Project>
